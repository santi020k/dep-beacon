---
import { Icon, Tabs, TabsList, TabsPanel, TabsTrigger } from '@santi020k/lumen-astro'

const editors = [
  { value: 'vscode', name: 'VS Code', source: '/usage-preview.png', width: 1600, height: 900, href: '/docs/vscode-extension', description: 'Version status, CodeLens update actions, and security diagnostics in the sample workspace.' },
  { value: 'zed', name: 'Zed', source: '/zed-preview.jpg', width: 3024, height: 1898, href: '/docs/zed-extension', description: 'Real pnpm catalog analysis with inline versions, update warnings, and an OSV high-risk signal.' }
]
---

<Tabs class="editor-showcase" initialValue="vscode">
  <div class="showcase-heading">
    <TabsList aria-label="Editor screenshots">
      {editors.map(editor => <TabsTrigger value={editor.value}>{editor.name}</TabsTrigger>)}
    </TabsList>
    <span class="showcase-note"><span aria-hidden="true"></span> From the sample workspace</span>
  </div>
  {editors.map((editor, index) => (
    <TabsPanel value={editor.value} hidden={index !== 0}>
      <figure class="product-preview">
        <a class="showcase-stage" href={editor.source} aria-label={`View the full-size ${editor.name} screenshot`}>
          <img src={editor.source} width={editor.width} height={editor.height} loading="lazy" decoding="async" alt={`Dep Beacon in ${editor.name}. ${editor.description}`} />
          <span class="showcase-expand" aria-hidden="true"><Icon name="arrow-up-right" /> View full size</span>
        </a>
        <figcaption><span>{editor.description}</span><a href={editor.href}>Explore {editor.name} <Icon name="arrow-right" /></a></figcaption>
      </figure>
    </TabsPanel>
  ))}
</Tabs>

<style>
  .editor-showcase {
    min-width: 0;

  }
  .showcase-heading {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 1.25rem;

  }
  .showcase-heading [role='tablist'] {
    background: var(--dep-surface);
    border: 1px solid var(--dep-rule);
    border-radius: 999px;
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.3rem;

  }
  .showcase-heading [role='tab'] {
    border-radius: 999px;
    color: var(--dep-ink-soft);
    font-size: 0.875rem;
    font-weight: 650;
    min-height: 2.75rem;
    padding: 0.65rem 1.4rem;

  }
  .showcase-heading [role='tab'][aria-selected='true'] {
    background: var(--dep-ink);
    color: var(--bg);

  }
  .showcase-note {
    align-items: center;
    color: var(--dep-ink-soft);
    display: flex;
    font-size: 0.75rem;
    gap: 0.5rem;

  }
  .showcase-note span {
    background: var(--green);
    border-radius: 50%;
    height: 0.375rem;
    width: 0.375rem;

  }
  .product-preview > .showcase-stage {
    background: #0b1115 url('/images/beacon-backdrop.webp') center / cover;
    border-radius: 1.5rem;
    padding: clamp(1rem, 4vw, 3rem);
    position: relative;

  }
  .showcase-stage img {
    border: 1px solid #ffffff26;
    border-radius: 0.75rem;
    box-shadow: 0 1.5rem 4rem #0005;

  }
  .showcase-expand {
    align-items: center;
    background: #0b1115;
    border: 1px solid #7dd3fc66;
    border-radius: 999px;
    bottom: 1rem;
    color: #f4fbf8;
    display: inline-flex;
    font-size: 0.7rem;
    gap: 0.5rem;
    padding: 0.5rem 0.8rem;
    position: absolute;
    right: 1rem;

  }
  .showcase-expand :global(svg) {
    height: 0.9rem;
    width: 0.9rem;

  }
  .product-preview figcaption > span {
    max-width: 66ch;

  }
  @media (width <= 40rem) {
    .showcase-note {
    display: none;

  }
    .showcase-expand {
    bottom: 0.65rem;
    right: 0.65rem;

  }
    .product-preview > .showcase-stage {
    border-radius: 1rem;
    padding: 0.75rem;

  }
    .showcase-stage img {
    border-radius: 0.5rem;

  }
    .product-preview figcaption {
    gap: 0.25rem;

  }

  }
</style>
