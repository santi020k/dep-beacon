---
import { Link } from '@santi020k/lumen-astro'

import { SITE } from '../site.config'
---

<footer class="site-footer" transition:name="site-footer" transition:persist>
  <p>{SITE.name} is built for maintainers who live in manifests.</p>
  <div>
    <Link href="/docs">Docs</Link>
    <Link href={SITE.marketplaceUrl} target="_blank" rel="noopener noreferrer">Marketplace</Link>
    <Link href={SITE.openVsxUrl} target="_blank" rel="noopener noreferrer">Open VSX</Link>
    <Link href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</Link>
    <Link href={SITE.personalUrl} target="_blank" rel="noopener noreferrer">santi020k.com</Link>
    <Link href="https://github.com/sponsors/santi020k" target="_blank" rel="noopener noreferrer">Sponsor</Link>
  </div>
</footer>
