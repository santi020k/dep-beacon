---
import { Link } from '@santi020k/lumen-astro'

import { DOCS_NAV } from '../data/nav'

const currentPath = Astro.url.pathname.replace(/\/$/u, '') || '/'
---

<aside class="docs-sidebar">
  <p class="eyebrow">Field guide</p>
  <nav aria-label="Documentation chapters">
    {DOCS_NAV.map((item, index) => (
      <Link aria-current={currentPath === item.href ? 'page' : undefined} href={item.href}>
        <span class="nav-number" aria-hidden="true">{String(index).padStart(2, '0')}</span>
        <span>{item.label}</span>
      </Link>
    ))}
  </nav>
  <p class="sidebar-note">Dependency intelligence.<br />Right where you work.</p>
</aside>
