---
import { ButtonLink } from '@santi020k/lumen-astro'

import Base from '../layouts/Base.astro'
---

<Base title="Not Found" description="Dep Beacon page not found." noindex>
  <section class="section">
    <div class="section-inner">
      <p class="eyebrow">404</p>
      <h1>That page is out of range.</h1>
      <p>Head back to the docs and follow the latest signal.</p>
      <p><ButtonLink class="button primary" href="/docs">Open docs</ButtonLink></p>
    </div>
  </section>
</Base>
