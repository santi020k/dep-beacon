---
import { Badge, ButtonLink, Icon } from '@santi020k/lumen-astro'

import Docs from '../../layouts/Docs.astro'

const guides = [
  { href: '/docs/installation', title: 'Install Dep Beacon', description: 'Choose your editor and open your first manifest.' },
  { href: '/docs/vscode-extension', title: 'Work in VS Code', description: 'Read inline signals, inspect hovers, and choose an update.' },
  { href: '/docs/zed-extension', title: 'Work in Zed', description: 'Use native diagnostics, code actions, and optional inlay hints.' },
  { href: '/docs/pnpm-workspaces', title: 'Connect your workspace', description: 'Understand default catalogs, named catalogs, and shared policy.' },
  { href: '/docs/security', title: 'Read security signals', description: 'Separate available updates from reported vulnerability risk.' },
  { href: '/docs/configuration', title: 'Make it yours', description: 'Adjust registry, privacy, display, and installation settings.' }
]
---

<Docs title="Docs" description="Dep Beacon documentation for VS Code and Zed users.">
  <header class="docs-page-header">
    <p class="docs-eyebrow"><span>Documentation</span> / Field guide</p>
    <h1>A clearer view of your dependencies.</h1>
    <p class="docs-intro">
      Read the signal. Choose your next update. Keep the decision beside the manifest you are already editing.
    </p>
    <div class="docs-actions">
      <ButtonLink class="docs-primary-action" href="/docs/installation" variant="unstyled">
        Get started <span><Icon name="arrow-right" /></span>
      </ButtonLink>
      <ButtonLink class="docs-text-action" href="/docs/security" variant="unstyled">
        Understand the signals <Icon name="arrow-up-right" />
      </ButtonLink>
    </div>
    <dl class="docs-facts">
      <div><dt>Editors</dt><dd>VS Code + Zed</dd></div>
      <div><dt>Packages</dt><dd>npm ecosystem</dd></div>
      <div><dt>Security data</dt><dd>OSV.dev</dd></div>
    </dl>
  </header>

  <section aria-labelledby="find-your-guide">
    <div class="docs-section-heading">
      <h2 id="find-your-guide">Find your next step</h2>
      <p>From first install to workspace policy.</p>
    </div>
    <div class="docs-link-list">
      {guides.map((guide, index) => (
        <a href={guide.href}>
          <span class="docs-row-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div><h3>{guide.title}</h3><p>{guide.description}</p></div>
          <Icon name="arrow-up-right" />
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="read-the-signal">
    <h2 id="read-the-signal">Read the signal</h2>
    <p>
      Dep Beacon combines npm metadata, semver-aware update targets, pnpm catalog resolution, and OSV advisories.
      Version status and security risk stay distinct, so you can decide what needs attention.
    </p>
    <dl class="docs-status-list">
      <div><dt><Badge variant="success">Up to date</Badge></dt><dd>Your declared range already accepts the latest
        stable version.</dd></div>
      <div><dt><Badge variant="warning">Update available</Badge></dt><dd>A newer target is available. Choose patch,
        minor, major, or latest.</dd></div>
      <div><dt><Badge variant="destructive">Needs attention</Badge></dt><dd>Review missing packages, invalid
        ranges, or reported security risk.</dd></div>
    </dl>
  </section>

  <section aria-labelledby="supported-files">
    <h2 id="supported-files">At home in your manifests</h2>
    <dl class="docs-reference">
      <div>
        <dt><code>package.json</code></dt>
        <dd>Dependency sections, npm overrides, Yarn resolutions, and pnpm-specific blocks.</dd>
      </div>
      <div>
        <dt><code>pnpm-workspace.yaml</code></dt>
        <dd>Default and named catalogs, overrides, and package extensions. The <code>.yml</code> extension works
          too.</dd>
      </div>
      <div>
        <dt>Your editor</dt>
        <dd>Inspect a dependency, choose an update, or use VS Code commands to refresh signals, sort manifests, and
          run installs.</dd>
      </div>
    </dl>
  </section>
</Docs>
