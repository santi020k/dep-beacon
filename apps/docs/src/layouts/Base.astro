---
import { ClientRouter } from 'astro:transitions'

import '../styles/global.css'

import UIPrimitives from '@santi020k/lumen-astro/runtime'

import manifest from '../../public/og/manifest.json'
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import { SITE } from '../site.config'

interface Props {
  description?: string
  image?: string
  imageAlt?: string
  keywords?: readonly string[] | string
  noindex?: boolean
  title?: string
}

const {
  description = SITE.description,
  image = SITE.ogImage,
  imageAlt = `${SITE.name} social preview`,
  keywords = SITE.keywords,
  noindex = false,
  title = SITE.name
} = Astro.props

const pageTitle = title === 'Dep Beacon' ? title : `${title} | Dep Beacon`
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).toString()
const pathname = Astro.url.pathname.replace(/\/$/u, '') || '/'
const route = Object.values(manifest.routes).find(route => route.pathname === pathname)
const generatedImage = route?.images.find(image => image.primary)
let imagePath = image

if (generatedImage?.url && (!Astro.props.image || generatedImage.url.split('?')[0] === image)) {
  imagePath = generatedImage.url
}

const imageUrl = new URL(imagePath, SITE.url).toString()
const keywordContent = typeof keywords === 'string' ? keywords : keywords.join(', ')

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    applicationCategory: 'DeveloperApplication',
    description: SITE.description,
    name: SITE.name,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD'
    },
    operatingSystem: 'Windows, macOS, Linux',
    sameAs: [SITE.githubUrl, SITE.marketplaceUrl, SITE.openVsxUrl, SITE.personalUrl],
    url: SITE.url
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    description,
    image: imageUrl,
    isPartOf: {
      '@type': 'WebSite',
      name: SITE.name,
      url: SITE.url
    },
    name: pageTitle,
    url: canonicalUrl
  }
]
---

<!doctype html>
<html lang="en" data-theme="dark" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordContent} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <meta name="theme-color" content="#0b1115" />
    <script is:inline>
      (() => {
        const root = document.documentElement
        let theme = 'dark'

        try {
          const storedTheme = localStorage.getItem('dep-beacon-theme')

          if (storedTheme === 'light' || storedTheme === 'dark') {
            theme = storedTheme
          } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light'
          }
        } catch {
          // Keep the dark default when storage is unavailable.
        }

        root.dataset.theme = theme

        root.classList.toggle('dark', theme === 'dark')

        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          'content', theme === 'dark' ? '#0b1115' : '#f5f8fa'
        )
      })()
    </script>
    <title>{pageTitle}</title>
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <ClientRouter fallback="swap" />
    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <UIPrimitives />
    <Nav />
    <main id="main-content" tabindex="-1" transition:name="page-content">
      <slot />
    </main>
    <Footer />
    <script>
      import type { TransitionBeforeSwapEvent } from 'astro:transitions/client'

      document.addEventListener('astro:before-swap', (event: TransitionBeforeSwapEvent) => {
        const theme = document.documentElement.dataset.theme

        if (theme === 'dark' || theme === 'light') {
          event.newDocument.documentElement.dataset.theme = theme

          event.newDocument.documentElement.classList.toggle('dark', theme === 'dark')

          event.newDocument.querySelector('meta[name="theme-color"]')?.setAttribute(
            'content', theme === 'dark' ? '#0b1115' : '#f5f8fa'
          )
        }
      })

      document.addEventListener('ui:theme-change', () => {
        const themeColor = document.querySelector('meta[name="theme-color"]')
        const isDark = document.documentElement.dataset.theme === 'dark'

        themeColor?.setAttribute('content', isDark ? '#0b1115' : '#f5f8fa')
      })
    </script>
  </body>
</html>
