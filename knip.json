{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "quality"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs"
      ],
      "project": [
        "scripts/**/*.mjs"
      ]
    },
    "apps/docs": {
      "entry": [
        "src/pages/**/*.astro",
        "og.config.mjs",
        "og.audit.config.mjs"
      ],
      "project": [
        "src/**/*.{astro,ts,css}"
      ]
    },
    "packages/dep-beacon-core": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "packages/vscode-dep-beacon": {
      "entry": [
        "scripts/*.cjs"
      ],
      "project": [
        "scripts/*.cjs",
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "packages/dep-beacon-lsp": {
      "entry": [
        "scripts/*.{cjs,mjs}",
        "src/server.ts"
      ],
      "project": [
        "scripts/*.{cjs,mjs}",
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    }
  }
}
