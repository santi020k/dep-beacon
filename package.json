{
  "name": "@santi020k/dep-beacon-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "assets": "node scripts/generate-assets.mjs",
    "build": "pnpm run assets && turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "check:astro": "pnpm --filter @santi020k/dep-beacon-docs check",
    "lint": "pnpm run lint:repo && turbo run lint -- --max-warnings=0",
    "lint:repo": "eslint . --cache --no-warn-ignored --max-warnings=0",
    "lint:fix": "pnpm run lint:repo:fix && turbo run lint:fix",
    "lint:repo:fix": "eslint . --cache --fix --no-warn-ignored --max-warnings=0",
    "lint:spell": "cspell \"**\" --gitignore --cache --show-suggestions --show-context",
    "lint:knip": "knip",
    "validate": "pnpm run build && pnpm run typecheck && pnpm run test:coverage && pnpm run lint && pnpm run lint:spell && pnpm run lint:knip && pnpm run package:extension",
    "ok": "pnpm install --frozen-lockfile && pnpm run validate",
    "changeset": "changeset",
    "version-packages": "node scripts/with-release-env.mjs changeset version && pnpm --filter @santi020k/dep-beacon-lsp sync:extension-version && pnpm install --lockfile-only",
    "release": "turbo run build && node scripts/with-release-env.mjs changeset publish",
    "dev:docs": "pnpm --filter @santi020k/dep-beacon-docs dev",
    "dev:extension": "pnpm --parallel --filter @santi020k/dep-beacon-core --filter vscode-dep-beacon run dev",
    "build:zed": "pnpm --filter @santi020k/dep-beacon-lsp build",
    "validate:zed": "pnpm --filter @santi020k/dep-beacon-lsp validate:extension",
    "package:extension": "pnpm --filter vscode-dep-beacon package",
    "publish:ext": "pnpm --filter vscode-dep-beacon publish:ext",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run check:astro && pnpm run typecheck && pnpm run test && pnpm run lint",
    "commit": "czg"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@santi020k/eslint-config-astro": "catalog:",
    "@santi020k/eslint-config-basic": "catalog:",
    "@santi020k/eslint-config-extensions": "catalog:",
    "@santi020k/eslint-config-formats": "catalog:",
    "@santi020k/eslint-config-libraries": "catalog:",
    "@santi020k/eslint-config-testing": "catalog:",
    "@santi020k/eslint-config-tools": "catalog:",
    "@typescript/native": "catalog:",
    "@types/node": "catalog:",
    "cspell": "catalog:",
    "czg": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "lint-staged": {
    "*.{astro,js,mjs,ts,mts}": [
      "eslint --fix --no-warn-ignored --max-warnings=0"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "eslint --fix --no-warn-ignored --max-warnings=0"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.1.2"
}
